# Control plane. Generate long random values locally; never commit real keys.
OPSATLAS_HOST=127.0.0.1
OPSATLAS_PORT=4318
OPSATLAS_DATABASE_PATH=./data/opsatlas.db
OPSATLAS_CREDENTIAL_KEY=generate-a-separate-random-value-of-at-least-32-characters
OPSATLAS_DASHBOARD_TOKEN=generate-a-separate-random-dashboard-token-of-at-least-24-characters
OPSATLAS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional migration path for static keys. Managed enrollment is preferred.
OPSATLAS_AGENT_KEYS={}

# Agent
OPSATLAS_DEVICE_ID=demo-node-01
# Set either a one-time enrollment token or an existing agent key.
OPSATLAS_ENROLLMENT_TOKEN=
OPSATLAS_AGENT_KEY=
OPSATLAS_ENDPOINT=http://127.0.0.1:4318/api/v1/telemetry
OPSATLAS_INTERVAL_MS=30000
OPSATLAS_DISK_PATH=.
OPSATLAS_STATE_PATH=./data/agent-state.json
# Optional explicit checks only. OpsAtlas never scans ports or discovers hosts.
OPSATLAS_CHECKS=[]
