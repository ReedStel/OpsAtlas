# Control plane. Generate long random values locally; never commit real keys.
OPSATLAS_HOST=127.0.0.1
OPSATLAS_PORT=4318
OPSATLAS_AGENT_KEYS={"lab-linux-03":"replace-with-at-least-24-random-characters"}
OPSATLAS_DASHBOARD_TOKEN=replace-with-a-long-random-dashboard-token
OPSATLAS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Agent
OPSATLAS_DEVICE_ID=lab-linux-03
OPSATLAS_AGENT_KEY=replace-with-the-matching-agent-key
OPSATLAS_ENDPOINT=http://127.0.0.1:4318/api/v1/telemetry
OPSATLAS_INTERVAL_MS=30000
OPSATLAS_DISK_PATH=.
# Optional explicit checks only. OpsAtlas never scans ports or discovers hosts.
OPSATLAS_CHECKS=[]
