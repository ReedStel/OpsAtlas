{
  "name": "opsatlas-console",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReedStel/OpsAtlas.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build && npm run validate:artifact",
    "start": "vinext start",
    "test": "npm run build && node --test tests/console-render.test.mjs",
    "build:services": "tsc -p tsconfig.services.json",
    "test:services": "npm run build:services && node --test services/tests/*.test.mjs",
    "start:control": "node .opsatlas-build/services/control-plane/server.js",
    "start:agent": "node .opsatlas-build/services/agent/agent.js",
    "check": "npm run lint && npm run test:services && npm test",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "OpsAtlas"
}
